generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                         Int                       @id @default(autoincrement())
  lead_no                    String?
  f_name                     String?
  m_name                     String?
  l_name                     String?
  full_name                  String?
  pan                        String?
  gender                     Gender?
  dob                        DateTime?
  aadhaar                    String?
  elegible_loan_amount       Decimal?                  @db.Decimal(10, 2)
  loan_amount                Decimal?                  @db.Decimal(10, 2)
  tenure                     Int?
  dpd                        Int?
  mobile                     String?
  alternate_mobile           String?
  personal_email             String?
  office_email               String?
  allocated_to               Int?
  assigned_to                Int?
  lead_stage                 String?                   @default("PENDING_LEAD")
  remarks                    String?
  is_lead_completed          Boolean                   @default(false)
  is_lead_closed             Boolean                   @default(false)
  is_lead_verify_by_otp      Boolean                   @default(false)
  repayment_date             DateTime?
  is_kyc_approved            Boolean                   @default(false)
  is_kyc_reject              Boolean                   @default(false)
  kyc_rejected_by            Int?
  is_bre_complete            Boolean?                  @default(false)
  is_bsa_complete            Boolean?                  @default(false)
  is_bre_reject              Boolean?                  @default(false)
  bre_rejected_by            Int?
  is_personal_email_verify   Boolean?                  @default(false)
  is_office_email_verify     Boolean?                  @default(false)
  is_employee_type_filled    Boolean?                  @default(false)
  is_loan_requested          Boolean?                  @default(false)
  address                    String?
  state                      String?
  country                    String?
  pincode                    String?
  city                       String?
  lat                        String?
  lng                        String?
  is_reloan_case             Boolean?                  @default(false)
  is_sanction                Boolean                   @default(false)
  is_disbursed               Boolean                   @default(false)
  is_closed                  Boolean                   @default(false)
  is_active                  Boolean                   @default(true)
  source                     String?
  is_hold                    Boolean?                  @default(false)
  is_rejected                Boolean?                  @default(false)
  rejected_by                Int?
  approved_by                Int?
  rejection_remarks          String?
  credit_score               Int?
  is_person_salaried         Boolean?                  @default(true)
  is_disposed                Boolean?                  @default(false)
  disposed_by                Int?
  disposed_at                DateTime?
  disposed_reason            String?
  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @updatedAt
  loan_no                    String?
  customer_id                Int?
  sanction_id                Int?
  disbursal_id               Int?
  collection_id              Int?
  is_feedback_submitted      Boolean?                  @default(false)
  is_reference_added         Boolean?                  @default(false)
  is_alternate_mobile_verify Boolean?                  @default(false)
  salary_date                DateTime?
  fixed_salary_date          DateTime?
  prev_emp_id                Int?
  monthly_income             Decimal?                  @db.Decimal(10, 2)
  company_name               String?
  ip                         String?
  is_bsa_pending             Boolean?                  @default(false)
  kyc_approved_reason        String?
  auto_rejection             Int?
  // location                   Unsupported("geography")?
  is_add_address             Boolean?                  @default(false)
  is_kyc_audit               Boolean?                  @default(false)
  is_next_loan_applied       Boolean?
  severity_code              Int?
  allocated_at               DateTime?
  assigned_at                DateTime?
  collection_assigned_by     Int?
  collection_assigned_to     Int?
  loan_count                 Int?
  inquiery_count             Int?
  payday_count               Int?
  region                     String?
  version                    Int?
  designation                String?
  work_location              String?
  employment_tenure_years    Int?
  employment_tenure_months   Int?
  previous_salary_date       DateTime?
  father_name                String?
  marital_status             String?
  religion                   String?
  is_document_added          Boolean?

  collection_assigned_at DateTime?
  collection             Collection[]
  disbursal              Disbursal?
  sanction               Sanction?
  kyc_audit              kyc_audit?
  lead_comments          lead_comments[]

  @@index([lead_no])
  @@index([customer_id])
  // Almost every v3 User controller does
  // `findFirst({ where: { customer_id }, orderBy: { created_at: "desc" } })`
  // (and the pan-keyed equivalent) to get "this customer's current lead" --
  // a composite index lets Postgres satisfy both the filter and the sort
  // from one index instead of filtering then sorting. See
  // prisma/migrations/*_add_lead_latest_lookup_indexes for how to apply
  // this without locking the table (CREATE INDEX CONCURRENTLY).
  @@index([customer_id, created_at(sort: Desc)])
  @@index([pan, created_at(sort: Desc)])
  @@index([sanction_id])
  @@index([disbursal_id])
  @@index([pan])
  @@index([aadhaar])
  @@index([mobile])
  @@index([personal_email])
  @@index([source])
  @@index([lead_stage])
  @@index([created_at])
  @@index([allocated_to])
  @@index([assigned_to])
  @@index([updated_at])
  @@index([is_reloan_case])
  @@index([personal_email], map: "idx_lead_personal_email")
  @@index([office_email])
  @@index([is_disposed])
  @@index([disposed_by])
}

model Customer {
  id                               Int       @id @default(autoincrement())
  customer_no                      String?
  pan                              String    @unique
  aadhaar                          String?
  f_name                           String?
  m_name                           String?
  l_name                           String?
  full_name                        String?
  gender                           Gender?
  dob                              DateTime?
  mobile                           String?
  alternate_mobile                 String?
  personal_email                   String?
  office_email                     String?
  address                          String?
  state                            String?
  country                          String?
  pincode                          String?
  city                             String?
  employement_type                 String?
  monthly_income                   Decimal?  @db.Decimal(10, 2)
  loan_count                       Int       @default(0)
  credit_score                     Int?
  recent_credit_score_date         DateTime?
  is_active                        Boolean   @default(true)
  is_logged_in                     Boolean?
  last_logged_in                   DateTime?
  auth_token                       String?
  uan                              String?
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt
  remarks                          String?
  failed_email_validation_attempts Int       @default(0)
  email_blocked_until              DateTime?
  failed_email_check_count         Int       @default(0)
  is_email_check_blocked           Boolean   @default(false)
  profile_image                    String?
  aadhaar_image                    String?
  face_match_score                 Decimal?  @db.Decimal(5, 4)

  @@index([mobile])
  @@index([personal_email])
  @@index([office_email])
  @@index([state])
  @@index([city])
  @@index([pincode])
  @@index([pan])
}

model Sanction {
  id                               Int       @id @default(autoincrement())
  pan                              String?
  lead_id                          Int?      @unique
  lead_no                          String?
  loan_no                          String    @unique
  sanction_date                    DateTime?
  loan_amount                      Decimal?  @db.Decimal(10, 2)
  repayment_date                   DateTime?
  repayment_amount                 Decimal?  @db.Decimal(10, 2)
  processing_fee                   Decimal?  @db.Decimal(10, 2)
  roi                              Decimal?  @db.Decimal(10, 2)
  pf_percent                       Decimal?  @db.Decimal(10, 2)
  pf_amount                        Decimal?  @db.Decimal(10, 2)
  insurance                        Decimal?  @db.Decimal(10, 2)
  total_admin_fee                  Decimal?  @db.Decimal(10, 2)
  net_admin_fee                    Decimal?  @db.Decimal(10, 2)
  net_disbursal                    Decimal?  @db.Decimal(10, 2)
  interest_amount                  Decimal?  @db.Decimal(10, 2)
  gst                              Decimal?  @db.Decimal(10, 2)
  apr                              Decimal?  @db.Decimal(10, 2)
  tenure                           Decimal?  @db.Decimal(10, 2)
  penalty_rate                     Decimal   @default(2.00) @db.Decimal(10, 2)
  is_override_repayment_date       Boolean?
  override_reason                  String?
  repayment_status_type            Int? // 0 -> sameAsSalaryDate , 1 -> beforeSalaryDate(without override) , 2 -> beforeSalaryDate(with override), 3 -> afterSalaryDate(with override), 4 -> , 99 -> for Catch Error
  remarks                          String?
  is_eSign_pending                 Boolean   @default(false)
  is_eSigned                       Boolean   @default(false)
  is_on_hold                       Boolean   @default(false)
  is_rejected                      Boolean   @default(false)
  rejected_by                      Int?
  is_disbursed                     Boolean   @default(false)
  approved_by                      Int?
  document_id                      String?
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt
  repayment_amount_on_receive_date Decimal?  @db.Decimal(10, 2)
  loan_growth_percentage           Decimal?  @db.Decimal(10, 2)
  lead                             Lead?     @relation(fields: [lead_id], references: [id])

  ontime_interest         Decimal?  @default(0.00) @db.Decimal(10, 2)
  ontime_repayment_amount Decimal?  @default(0.00) @db.Decimal(10, 2)
  penalty_amount          Decimal?  @default(0.00) @db.Decimal(10, 2)
  dpd                     Int?      @default(0)
  current_dpd             Int?
  last_calc_date          DateTime?

  @@index([lead_id])
  @@index([lead_no])
  @@index([pan])
  @@index([sanction_date])
  @@index([is_disbursed])
  @@index([last_calc_date])
}

model Disbursal {
  id                     Int       @id @default(autoincrement())
  lead_id                Int       @unique
  loan_no                String?
  pan                    String?
  sanction_id            Int?
  payable_account        String?
  payment_mode           String
  amount                 Decimal?  @db.Decimal(10, 2)
  utr                    String?
  transaction_history_id Int?
  disbursal_date         DateTime?
  is_active              Boolean   @default(true)
  is_closed              Boolean   @default(false)
  is_settled             Boolean   @default(false)
  is_write_off           Boolean   @default(false)
  is_on_hold             Boolean   @default(false)
  is_rejected            Boolean   @default(false)
  rejected_by            Int?
  is_disbursed           Boolean   @default(false)
  is_data_sent           Boolean   @default(false)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  loan_amount            Decimal?  @db.Decimal(10, 2)
  repayment_date         DateTime?
  repayment_amount       Decimal?  @db.Decimal(10, 2)
  roi                    Decimal?  @db.Decimal(10, 2)
  tenure                 Int?
  disbursed_by           Int?
  channel                String?
  remarks                String?
  status                 String?
  lead                   Lead      @relation(fields: [lead_id], references: [id])

  @@index([lead_id])
  @@index([loan_no])
  @@index([pan])
  @@index([sanction_id])
  @@index([disbursal_date])
}

model Collection {
  id                   Int       @id @default(autoincrement())
  customer_id          Int?
  lead_id              Int?
  loan_no              String?
  pan                  String?
  payment_mode         String?
  received_amount      Decimal?  @db.Decimal(10, 2)
  repayment_type       String?
  discount             Decimal?  @db.Decimal(10, 2)
  refund               Decimal?  @db.Decimal(10, 2)
  total_pg_charges     Decimal   @default(0.00) @db.Decimal(10, 2)
  date_of_recived      DateTime?
  payment_verification Int?
  sattelment           Decimal?  @db.Decimal(10, 2)
  remarks              String?
  collection_active    Boolean?
  repay_differ_type    Int? // 0-> not override , 1-> override(++), 2-> override(--)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  lead                 Lead?     @relation(fields: [lead_id], references: [id])

  @@index([lead_id])
  @@index([loan_no])
  @@index([pan])
  @@index([customer_id])
}

model Payment {
  id                    Int       @id @default(autoincrement())
  pan                   String?
  lead_id               Int?
  lead_no               String?
  loan_no               String?
  total_received_amount Decimal?  @db.Decimal(10, 2)
  interest_discount     Decimal?  @db.Decimal(10, 2)
  penalty_discount      Decimal?  @db.Decimal(10, 2)
  principal_discount    Decimal?  @db.Decimal(10, 2)
  interest_received     Decimal?  @db.Decimal(10, 2)
  penalty_received      Decimal?  @db.Decimal(10, 2)
  principal_received    Decimal?  @db.Decimal(10, 2)
  excess_amount         Decimal?  @db.Decimal(10, 2)
  pg_charges            Decimal   @default(0.00) @db.Decimal(10, 2)
  settled_amount        Decimal?
  writeOff_amount       Decimal?
  outstanding_amount    Decimal?
  received_amount       Decimal?  @db.Decimal(10, 2)
  payment_date          DateTime?
  payment_mode          String?
  transaction_id        String?   @unique
  closing_type          String?
  discount              Decimal?  @db.Decimal(10, 2)
  is_payment_verified   Boolean?  @default(false)
  is_rejected           Boolean?  @default(false)
  order_status          String?
  order_id              String?   @unique
  receipt_id            String?
  payment_method        String?
  is_partial_paid       Boolean?  @default(false)
  created_at            DateTime? @default(now())
  updated_at            DateTime? @updatedAt
  remarks               String?

  @@index([lead_id])
  @@index([loan_no])
  @@index([payment_date])
  @@index([created_at])
  @@index([pan])
}

model Api_Logs {
  id           Int      @id @default(autoincrement())
  pan          String?
  api_type     String?
  api_provider Int?
  api_request  Json?
  api_response Json?
  api_status   Boolean?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  customer_id  Int?
  lead_id      Int?
  remarks      String?

  @@index([pan])
  @@index([customer_id])
  @@index([lead_id])
  @@index([api_type])
  @@index([created_at])
}

model Document {
  id                Int      @id @default(autoincrement())
  pan               String?
  document_type     String?
  document_url      String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  remarks           String?
  customer_id       Int?
  lead_id           Int?
  is_validated      Boolean?
  validated_by      Int?
  document_category String?
  document_sub_type String?

  @@index([pan])
  @@index([customer_id])
  @@index([lead_id])
  @@index([document_type])
  @@index([lead_id, id])
  @@index([lead_id, document_category])
}

model Transaction_History {
  id                       Int      @id @default(autoincrement())
  pan                      String?
  lead_id                  Int?
  loan_no                  String?
  utr                      String?
  ref_no                   String?
  disbursal_id             Int?
  sanction_id              Int?
  amount                   Decimal? @db.Decimal(10, 2)
  transaction_request      Json?
  transaction_response     Json?
  transaction_pre_response Json?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
  bank_name                String?
  ifsc                     String?
  payable_account          String?
  payment_mode             String?
  remarks                  String?

  @@index([loan_no])
  @@index([utr])
  @@index([disbursal_id])
  @@index([sanction_id])
  @@index([created_at])
  @@index([lead_id])
  @@index([ref_no])
}

model Lead_Logs {
  id            Int      @id @default(autoincrement())
  customer_id   Int?
  lead_id       Int?
  pan           String?
  severity_code Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  remarks       String?

  @@index([lead_id, created_at(sort: Desc)])
  @@index([customer_id])
  @@index([lead_id])
  @@index([pan])
}

model Employee {
  id                Int     @id @default(autoincrement())
  emp_id            String  @unique
  f_name            String?
  l_name            String?
  email             String  @unique
  password          String?
  gender            Gender
  mobile            String?
  profile_image_url String?
  is_active         Boolean @default(true)
  is_logged_in      Boolean
  is_on_holiday     Boolean @default(false)
  emp_sequence_id   Int     @default(0)

  created_at     DateTime        @default(now())
  last_logged_in DateTime?
  updated_at     DateTime        @updatedAt
  logs           Employee_Logs[]
  roles          Employee_Role[]
  lead_comments  lead_comments[]
}

model Role {
  id         Int             @id @default(autoincrement())
  role_name  String          @unique
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  employees  Employee_Role[]
}

model Employee_Role {
  employee_id Int
  role_id     Int
  assigned_at DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([employee_id, role_id])
  @@index([role_id])
}

model Employee_Logs {
  id          Int      @id @default(autoincrement())
  employee_id Int
  remarks     String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
}

model Counter {
  id             Int      @id @default(autoincrement())
  sequence_name  String?  @unique
  sequence_value Int?     @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model Bank_Details {
  id               Int      @id @default(autoincrement())
  customer_id      Int?
  lead_id          Int?
  pan              String?
  bank_name        String?
  branch_name      String?
  bank_acc_no      String?
  ifsc_code        String?
  beneficiary_name String?
  account_type     String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  fetch_from       Int?     @default(0)
  remarks          String?

  @@index([customer_id])
  @@index([lead_id])
  @@index([pan])
  @@index([bank_acc_no])
  @@index([ifsc_code])
}

model customer_address {
  id             Int      @id @default(autoincrement())
  customer_id    Int?
  lead_id        Int?
  pan            String?
  address_source String?
  address        String?
  state          String?
  country        String?
  pincode        String?
  city           String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  remarks        String?
  landmark       String?
  address_type   String?

  @@index([pan])
  @@index([customer_id])
  @@index([lead_id])
  @@index([pincode])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Bank_Statement_Report {
  id           Int      @id @default(autoincrement())
  pan          String
  api_provider Int?
  api_request  Json?
  api_response Json?
  api_status   Boolean?
  customer_id  Int?
  lead_id      Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  remarks      String?

  @@index([pan])
  @@index([customer_id])
  @@index([lead_id])
}

model blacklisted_pan {
  id            Int      @id @default(autoincrement())
  pan           String   @unique
  customer_name String?
  reason        String?
  dpd           String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([pan])
}

model serviceable_pin_code {
  id         Int      @id @default(autoincrement())
  pincode    String?
  district   String?
  state      String?
  firstTwo   Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([pincode])
}

model feedback_form {
  id                        Int      @id @default(autoincrement())
  over_all_interface        Int?
  navigate                  Int?
  easy_to_apply             Int?
  customer_centric_approach Int?
  recommend_to              Int?
  category                  String?
  feedback_text             String?
  lead_id                   Int?
  customer_id               Int?
  pan                       String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  remarks                   String?

  @@index([lead_id])
  @@index([pan])
  @@index([customer_id])
}

model references {
  id             Int      @id @default(autoincrement())
  lead_id        Int?
  customer_id    Int?
  pan            String?
  ref_no_1       String?
  ref_name_1     String?
  ref_no_2       String?
  ref_name_2     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  remarks        String?
  ref_add_1      String?
  ref_add_2      String?
  ref_relation_1 String?
  ref_relation_2 String?

  @@index([lead_id])
  @@index([customer_id])
  @@index([pan])
  @@index([ref_no_1])
  @@index([ref_no_2])
}

model IFSC_code {
  id         Int      @id @default(autoincrement())
  ifsc_code  String   @unique
  branch     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ifsc_code])
  @@index([branch])
}

model loyalty_points {
  id                Int       @id @default(autoincrement())
  customer_id       Int?
  lead_id           Int?
  pan               String?
  points_balance    Decimal?  @db.Decimal(10, 2)
  last_updated      DateTime  @updatedAt
  created_at        DateTime  @default(now())
  is_distributed    Boolean   @default(false)
  distribution_date DateTime?
  remarks           String?

  @@index([customer_id])
  @@index([lead_id])
}

model email_OTP {
  id           Int       @id @default(autoincrement())
  customer_id  Int?
  otp          String?
  expiry       DateTime?
  max_attempts Int?      @default(3)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([customer_id])
}

model mobile_otp {
  id           Int       @id @default(autoincrement())
  otp          String?
  expiry       DateTime?
  max_attempts Int?      @default(3)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  mobile       String?

  @@index([mobile])
}

model blacklisted_domain {
  id          Int     @id @default(autoincrement())
  domain_name String? @unique

  @@index([domain_name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model blacklisted_pincode {
  id         Int      @id @default(autoincrement())
  pincode    String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([pincode])
}

model kyc_audit {
  id                 Int      @id @default(autoincrement())
  lead_id            Int      @unique
  customer_id        Int?
  pan                String?
  status             Int?     @default(0)
  remarks            String?
  linkedin_url       String?
  website_url        String?
  gst_no             String?
  company_name       String?
  is_linkedin_verify Boolean  @default(false)
  is_website_verify  Boolean  @default(false)
  is_bsa_run         Boolean  @default(false)
  is_company_verify  Boolean  @default(false)
  assigned_to        Int?     @default(0)
  assigned_by        Int?     @default(0)
  approved_by        Int?     @default(0)
  rejected_by        Int?     @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  lead               Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([customer_id])
  @@index([pan])
  @@index([status])
  @@index([assigned_to])
  @@index([approved_by])
  @@index([rejected_by])
}

model fraud_cases {
  id                         Int                       @id @default(autoincrement())
  product_type               String?
  loan_id                    String?
  client_customer_id         String?
  credit_account_holder_name String?
  credit_account_holder_type String?
  credit_account_number      String?
  credit_bank_ifsc_code      String?
