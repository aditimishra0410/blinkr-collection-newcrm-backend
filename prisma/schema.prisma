  call_duration       Int?
  completed_by        String?   @db.VarChar(50)
  queue_name          String?   @db.VarChar(100)
  queue_duration      Int?
  ring_duration       Int?
  followup_time       String?   @db.VarChar(50)
  station             String?   @db.VarChar(50)
  list_id             String?   @db.VarChar(100)
  lead_id             String    @db.VarChar(100)
  did                 String?   @db.VarChar(50)
  recording_file_name String?
  /// CRM Lead.id after resolve
  crm_lead_id         Int?
  loan_no             String?   @db.VarChar(50)
  lead_no             String?   @db.VarChar(50)
  customer_id         Int?
  customer_name       String?   @db.VarChar(200)
  match_status        String?   @db.VarChar(40)
  match_by            String?   @db.VarChar(30)
  raw_payload         Json?
  received_at         DateTime  @default(now())

  @@index([lead_id])
  @@index([call_reference_id])
  @@index([user_id])
  @@index([received_at])
  @@index([crm_lead_id])
  @@index([loan_no])
  @@index([match_status])
  @@map("convox_call_logs")
}

model convox_call_popup {
  id                        BigInt    @id @default(autoincrement())
  agent_id                  String    @db.VarChar(100)
  call_hit_reference_number String    @db.VarChar(64)
  process_name              String?   @db.VarChar(100)
  mobile_number             String    @db.VarChar(20)
  lead_id                   String    @db.VarChar(100)
  entry_date                DateTime?
  call_type                 String?   @db.VarChar(30)
  station                   String?   @db.VarChar(50)
  /// CRM Lead.id after resolve
  crm_lead_id               Int?
  loan_no                   String?   @db.VarChar(50)
  lead_no                   String?   @db.VarChar(50)
  customer_id               Int?
  customer_name             String?   @db.VarChar(200)
  match_status              String?   @db.VarChar(40)
  match_by                  String?   @db.VarChar(30)
  raw_payload               Json?
  received_at               DateTime  @default(now())

  @@index([lead_id])
  @@index([call_hit_reference_number])
  @@index([agent_id])
  @@index([mobile_number])
  @@index([received_at])
  @@index([crm_lead_id])
  @@index([loan_no])
  @@index([match_status])
  @@map("convox_call_popup")
}

model additional_document_request {
  id                Int       @id @default(autoincrement())
  lead_id           Int
  customer_id       Int?
  pan               String?
  document_category String
  document_sub_type String?
  document_label    String?
  remarks           String?
  is_uploaded       Boolean   @default(false)
  document_id       Int?
  uploaded_at       DateTime?
  uploaded_by_type  String?
  uploaded_by       Int?
  upload_source     String?
  requested_by      Int
  requested_at      DateTime  @default(now())
  is_active         Boolean   @default(true)
  cancelled_by      Int?
  cancelled_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([lead_id, document_category], map: "additional_document_request_lead_id_document_category_key")
  @@index([lead_id, is_uploaded])
  @@index([customer_id])
  @@index([document_id])
}

/// Master: third-party collection agencies
model collection_agency {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(150)
  contact_person String?  @db.VarChar(100)
  mobile         String?  @db.VarChar(20)
  email          String?  @db.VarChar(100)
  address        String?
  is_active      Boolean  @default(true)
  remarks        String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users     collection_agency_user[]
  cases     collection_agency_case[]
  customers collection_agency_customer[]

  @@index([is_active])
  @@map("collection_agency")
}

/// Agency portal login users
model collection_agency_user {
  id            Int       @id @default(autoincrement())
  agency_id     Int
  name          String    @db.VarChar(150)
  mobile        String?   @db.VarChar(20)
  email         String    @unique @db.VarChar(150)
  designation   String    @db.VarChar(80)
  password      String
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  agency collection_agency @relation(fields: [agency_id], references: [id], onDelete: Cascade)

  @@index([agency_id])
  @@index([mobile])
  @@index([designation])
  @@index([is_active])
  @@map("collection_agency_user")
}

/// Lightweight agency cases
model collection_agency_case {
  id                 Int       @id @default(autoincrement())
  agency_id          Int
  lead_id            Int
  cust_id            Int?
  loan_no            String?   @db.VarChar(50)
  lead_no            String?   @db.VarChar(50)
  customer_name      String?   @db.VarChar(200)
  mobile             String?   @db.VarChar(20)
  dpd_at_handoff     Int?
  outstanding_amount Decimal?  @db.Decimal(12, 2)
  handoff_at         DateTime  @default(now())
  handoff_by         Int?
  assigned_to        Int?
  assigned_by        Int?
  assigned_at        DateTime?
  status             String    @default("OPEN") @db.VarChar(30)
  remarks            String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  agency collection_agency            @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  logs   collection_agency_case_log[]

  @@unique([agency_id, lead_id])
  @@index([agency_id])
  @@index([lead_id])
  @@index([loan_no])
  @@index([assigned_to])
  @@index([status])
  @@index([handoff_at])
  @@map("collection_agency_case")
}

/// Activity logs on agency cases
model collection_agency_case_log {
  id         Int      @id @default(autoincrement())
  case_id    Int
  agency_id  Int?
  user_id    Int?
  action     String?  @db.VarChar(50)
  remarks    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  case collection_agency_case @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@index([agency_id])
  @@index([user_id])
  @@index([created_at])
  @@map("collection_agency_case_log")
}

/// Full CRM snapshot for DPD > 40 cases handed to agency
model collection_agency_customer {
  id                  Int       @id @default(autoincrement())
  agency_id           Int
  lead_id             Int
  cust_id             Int?
  pan                 String?   @db.VarChar(20)
  full_name           String?   @db.VarChar(200)
  loan_no             String?   @db.VarChar(50)
  personal_email      String?   @db.VarChar(150)
  office_email        String?   @db.VarChar(150)
  company_name        String?   @db.VarChar(200)
  salary_date         DateTime?
  collection_status   String?   @db.VarChar(40)
  repayment_date      DateTime?
  dpd                 Int?
  loan_amount         Decimal?  @db.Decimal(12, 2)
  net_disbursal       Decimal?  @db.Decimal(12, 2)
  sanction_date       DateTime?
  repayment_amount    Decimal?  @db.Decimal(12, 2)
  mobile              String?   @db.VarChar(20)
  ref_no_1            String?
  ref_no_2            String?
  alternate_mobile    String?   @db.VarChar(20)
  geo_state           String?   @db.VarChar(100)
  geo_city            String?   @db.VarChar(100)
  geo_pincode         String?   @db.VarChar(20)
  geo_address         String?
  aadhaar_state       String?   @db.VarChar(100)
  aadhaar_city        String?   @db.VarChar(100)
  aadhaar_pincode     String?   @db.VarChar(20)
  aadhaar_address     String?
  ongrid_addresses    String?
  cibil_addresses     String?
  residence_addresses String?
  office_addresses    String?
  received_amount     Decimal?  @db.Decimal(12, 2)
  date_of_recived     DateTime?
  current_outstanding Decimal?  @db.Decimal(12, 2)
  status              String    @default("OPEN") @db.VarChar(30)
  assigned_to         Int?
  assigned_by         Int?
  assigned_at         DateTime?
  handoff_by          Int?
  handoff_at          DateTime  @default(now())
  remarks             String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  agency collection_agency @relation(fields: [agency_id], references: [id], onDelete: Cascade)

  @@unique([agency_id, lead_id])
  @@index([agency_id])
  @@index([lead_id])
  @@index([loan_no])
  @@index([pan])
  @@index([dpd])
  @@index([status])
  @@index([assigned_to])
  @@index([handoff_at])
  @@map("collection_agency_customer")
}

model collection_disposition {
  id                Int       @id @default(autoincrement())
  lead_id           Int?
  cust_id           Int?
  emp_id            Int?
  disposition_code  String
  disposition_label String?
  ptp_amount        Decimal?  @db.Decimal(10, 2)
  ptp_date          DateTime?
  ptp_type          String?
  remarks           String?
  ptp_id            Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([lead_id])
  @@index([cust_id])
  @@index([emp_id])
  @@index([disposition_code])
  @@index([created_at])
}

/// Tracks A → B → C collection agent assignment trail per lead
model collection_assignment {
  id                   Int      @id @default(autoincrement())
  lead_id              Int?
  cust_id              Int?
  loan_no              String?
  assigned_to          Int?
  assigned_by          Int?
  previous_assigned_to Int?
  source               String?
  remarks              String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([lead_id])
  @@index([cust_id])
  @@index([assigned_to])
  @@index([assigned_by])
  @@index([loan_no])
  @@index([created_at])
}

model recovery_view_data {
  loan_no String  @id
  lead_id Int?
  pan     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// PayTracker CRM centralized activity / audit monitoring log (append-only).
model paytracker_activity_log {
  id BigInt @id @default(autoincrement())

  activity_at DateTime @default(now())

  employee_id     Int?
  employee_emp_id String?
  employee_name   String?
  employee_email  String?

  action  String
  details String?
  status  String  @default("Success")

  related_to   String?
  related_type String?
  related_id   String?
  loan_no      String?
  lead_id      Int?
  pan          String?

  ip_address String?
  city       String?
  pincode    String?
  state      String?
  location   String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  meta Json @default("{}")

  created_at DateTime @default(now())

  @@index([activity_at(sort: Desc)])
  @@index([employee_id, activity_at(sort: Desc)])
  @@index([action, activity_at(sort: Desc)])
  @@index([status, activity_at(sort: Desc)])
  @@index([related_type, related_id])
  @@index([loan_no])
  @@index([lead_id])
  @@index([ip_address])
}

/// PayTracker employee ↔ Convox user mapping master.
model convox_user_mapping {
  id             Int      @id @default(autoincrement())
  emp_id         String   @unique @db.VarChar(50)
  emp_name       String   @db.VarChar(200)
  emp_email      String   @db.VarChar(150)
  convox_user_id String   @unique @db.VarChar(100)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([emp_email])
  @@index([is_active])
  @@index([convox_user_id])
  @@map("convox_user_mapping")
}

/// Office locations a CRM login is allowed from. A login passes if the
/// submitted point is inside ANY active row, so multiple offices work with no
/// code change. Edit these rows to move the fence -- nothing is hardcoded.
model master_geofence_location {
  id       Int      @id @default(autoincrement())
  name     String?
  lat      Decimal? @db.Decimal(10, 7)
  lng      Decimal? @db.Decimal(10, 7)
  radius_m Int?     @default(100)

  is_active Boolean? @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// Employees exempt from the login geo-fence (field staff, ops on VPN, admins
/// who must be able to sign in to repair a bad geofence configuration).
model master_geofence_whitelist {
  id     Int     @id @default(autoincrement())
  emp_id Int     @unique
  reason String?

  is_active Boolean? @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([emp_id])
}
