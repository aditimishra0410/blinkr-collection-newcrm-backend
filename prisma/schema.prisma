// ============================================================
// YES BANK FTx integration (BeneDB + Fund Transfer + Callback)
// Backing tables for the /api/yes-bank/* REST wrapper. Independent
// of the Lead/Disbursal flow (lead_id below is a plain nullable
// reference, not a formal relation) so this module can be used
// standalone as well as from the loan disbursal flow..
// ============================================================

model YesBankBeneficiary {
