  transaction_limit Decimal? @db.Decimal(18, 2)
  currency_cd       String   @default("INR")
  upi_handle        String?
  mobile_no         String?
  email_id          String?
  address1          String?
  address2          String?
  status            String   @default("ACTIVE")
  bank_ref_id       String?
  last_action       String?
  request           Json?
  response          Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  transactions YesBankTransaction[]

  @@index([cust_id])
  @@index([status])
}

model YesBankTransaction {
