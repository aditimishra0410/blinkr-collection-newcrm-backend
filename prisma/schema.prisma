/// Settlement/OTS requests. No tenant_id (white-label, one DB per company).
/// loan_no/lead_id/raised_by_id are soft refs to the PayTracker Lead/Employee
/// data (lives outside this table) — names are snapshotted at write time.
model settlement_requests {
  id BigInt @id @default(autoincrement())

  loan_no       String
  lead_id       String?
  borrower_name String
  mobile        String?
  email         String?
  pan           String?

  loan_amt    Decimal  @default(0) @db.Decimal(14, 2)
  outstanding Decimal  @db.Decimal(14, 2)
  settle_amt  Decimal  @db.Decimal(14, 2)
  /// DB-generated: GREATEST(outstanding - settle_amt, 0) — never write this field
  waiver      Decimal? @db.Decimal(14, 2)

  dpd        Int     @default(0)
  /// DB-generated from dpd (no_dpd/1_30/31_60/61_90/91_120/121_180/180_plus) — never write this field
  dpd_bucket String?

  settle_type String    @default("OTS")
  settle_date DateTime? @db.Date
  reason      String
  notes       String?

  raised_by    String
  raised_by_id String?
  raised_on    DateTime @default(now())

  status        String    @default("pending")
  admin_remarks String?
  decided_by    String?
  decided_by_id String?
  decided_on    DateTime?

  letter_sent    Boolean   @default(false)
  letter_sent_on DateTime?
  letter_sent_to String?

  ndc_sent    Boolean   @default(false)
  ndc_sent_on DateTime?
  ndc_sent_to String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  events    settlement_events[]
  documents settlement_documents[]

  @@index([status, raised_on(sort: Desc)])
  @@index([loan_no])
  @@index([lead_id])
  @@index([raised_by_id, raised_on(sort: Desc)])
  @@index([dpd_bucket])
}

/// Append-only audit trail behind settlement_requests — never UPDATE/DELETE rows here.
model settlement_events {
  id            BigInt @id @default(autoincrement())
  settlement_id BigInt

  event_type  String
  from_status String?
  to_status   String?

  actor_name    String
  actor_user_id String?
  /// roles held AT THE TIME of the action
  actor_roles   String[]

  remarks String?
  meta    Json    @default("{}")

  created_at DateTime @default(now())

  settlement settlement_requests @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@index([settlement_id, created_at])
  @@index([event_type, created_at(sort: Desc)])
}

/// Every generated/dispatched settlement letter or NDC PDF.
model settlement_documents {
  id            BigInt @id @default(autoincrement())
  settlement_id BigInt

  doc_type String

  file_name       String
  file_url        String?
  file_size_bytes BigInt?
  checksum_sha256 String?

  sent_to       String?
  sent_cc       String[]
  email_subject String?
  sent_at       DateTime?
  sent_by       String?
  sent_by_id    String?

  delivery_status String  @default("pending")
  delivery_error  String?

  created_at DateTime @default(now())

  settlement settlement_requests @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@index([settlement_id, doc_type, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
}

